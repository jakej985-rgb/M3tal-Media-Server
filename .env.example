# --- Core Config ---
DASHBOARD_PORT=8080
STATE_DIR=./state
LOG_LEVEL=info

# --- Auth ---
# Use a strong secret for session management
DASHBOARD_SECRET=change_me_immediately
# API Token for dashboard -> backend communication
API_TOKEN=change_me_api_token
# Initial admin password for the dashboard
ADMIN_PASSWORD=admin_pass

# --- Network ---
# The Docker network name (standard is 'proxy')
NETWORK_NAME=proxy
# Local IP of the host machine
LOCAL_IP=127.0.0.1

# --- Storage ---
# Base path for media and config. 
# Defaults to /mnt for the standardized M3TAL layout.
BASE_STORAGE_PATH=/mnt
