{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "M3TAL Plugin Manifest Schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "m3tal/v1"
    },
    "kind": {
      "type": "string",
      "enum": ["Route", "Stack", "Middleware", "Traefik"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      },
      "required": ["name"]
    },
    "spec": {
      "type": "object"
    },
    "hooks": {
      "type": "object",
      "properties": {
        "pre-install": { "type": "string" },
        "post-install": { "type": "string" },
        "pre-enable": { "type": "string" },
        "post-enable": { "type": "string" },
        "pre-disable": { "type": "string" },
        "post-disable": { "type": "string" },
        "pre-uninstall": { "type": "string" },
        "post-uninstall": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"]
}
