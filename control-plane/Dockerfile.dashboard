# M3TAL Dashboard - Hardened Debian-Bookworm Base
FROM python:3.11-slim-bookworm

# Prevent debris and speed up installs
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 1. System Hardening & Resilient Tooling (Using Apt for Python packages to bypass Pip corruption)
RUN for i in {1..5}; do apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    curl \
    procps \
    python3-flask \
    python3-requests \
    python3-yaml \
    python3-psutil \
    python3-bcrypt \
    python3-eventlet \
    python3-flask-socketio \
    python3-pytest \
    python3-flake8 && break || sleep 5; done \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. Python Toolchain Hardening (Using stable base-image pip)
# Skipping upgrade to avoid hash-mismatch errors on unstable networks

# 4. Pinned Dependency Installation (Micro-layered for extreme persistence)
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 Flask
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 requests
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 PyYAML
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 psutil
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 Flask-SocketIO
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 eventlet
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 bcrypt==4.1.2
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 pygments
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 pytest
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 pytest-mock
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 flake8
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 -r /tmp/requirements.txt

# 4. Non-Root Execution Enforcement
RUN groupadd -g 1000 appuser && \
    useradd -m -u 1000 -g 1000 appuser

# Set workspace
WORKDIR /docker/dashboard

# Switch to non-privileged user
USER appuser

# Startup command
CMD ["python3", "server.py"]
