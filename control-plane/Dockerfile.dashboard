# M3TAL Dashboard - Hardened Debian-Bookworm Base
FROM python:3.11-slim-bookworm

# Prevent debris and speed up installs
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 1. System Hardening
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    curl \
    procps \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. Python Toolchain Hardening (Using stable base-image pip)
# Skipping upgrade to avoid hash-mismatch errors on unstable networks

# 3. Application Dependencies (Split into layers for resilient caching)
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 --prefer-binary Flask requests PyYAML psutil
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 --prefer-binary Flask-SocketIO eventlet bcrypt
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 --prefer-binary -r /tmp/requirements.txt

# 4. Non-Root Execution Enforcement
RUN groupadd -g 1000 appuser && \
    useradd -m -u 1000 -g 1000 appuser

# Set workspace
WORKDIR /docker/dashboard

# Switch to non-privileged user
USER appuser

# Startup command
CMD ["python3", "server.py"]
