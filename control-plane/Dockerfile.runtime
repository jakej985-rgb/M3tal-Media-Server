# M3TAL Runtime - Resilient Hardware monitoring base
FROM python:3.11-slim-bookworm

# Prevent debris and speed up installs
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 1. System Hardening & Resilient Tooling
# Using a retry loop for apt-get to survive connection resets
RUN for i in {1..5}; do apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    procps \
    util-linux \
    smartmontools \
    docker.io \
    radeontop && break || sleep 5; done \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. Hardware Tools Validation
RUN which smartctl || (echo "CRITICAL: smartctl failed to install!" && exit 1)

# 3. Python Toolchain (Using stable base-image pip)
# Skipping upgrade to avoid hash-mismatch errors on unstable networks

# 4. Pinned Dependency Installation (Micro-layered for extreme persistence)
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 requests
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 PyYAML
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 psutil
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 bcrypt==4.1.2

# 5. User Configuration
RUN groupadd -g 1000 appuser && \
    (getent group docker || groupadd -g 999 docker) && \
    useradd -m -u 1000 -g 1000 -G 0,docker appuser

WORKDIR /docker

# Standardize path for smartctl
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

USER root

# Default command
CMD ["python3", "control-plane/agents/run.py"]
