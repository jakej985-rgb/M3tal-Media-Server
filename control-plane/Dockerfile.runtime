# M3TAL Runtime - Ubuntu 22.04 Base
FROM ubuntu:22.04

# Prevent debris and speed up installs
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 1. System Hardening & Security Patching
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    curl \
    ca-certificates \
    gnupg \
    procps \
    util-linux \
    smartmontools \
    docker.io \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. Python Toolchain
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

# 3. Pinned Dependency Installation
RUN pip3 install --no-cache-dir \
    bcrypt==4.1.2 \
    requests==2.32.3 \
    PyYAML==6.0.2 \
    psutil==5.9.8

# 4. User Configuration
RUN groupadd -g 1000 appuser && \
    (getent group docker || groupadd -g 999 docker) && \
    useradd -m -u 1000 -g 1000 -G 0,docker appuser

WORKDIR /docker

# Standardize path for smartctl
ENV PATH="/usr/sbin:/usr/bin:/sbin:/bin:${PATH}"

USER root

# Default command
CMD ["python3", "control-plane/agents/run.py"]
