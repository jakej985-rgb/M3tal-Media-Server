# M3TAL Runtime - Resilient Hardware monitoring base
FROM debian:bookworm-slim

# Prevent debris and speed up installs
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 1. System Hardening & Resilient Tooling (Apt-First Python)
# Using Apt for core monitoring dependencies to survive connection resets
RUN for i in {1..5}; do apt-get update && \
    apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    curl \
    ca-certificates \
    gnupg \
    procps \
    util-linux \
    smartmontools \
    docker.io \
    radeontop \
    python3-requests \
    python3-yaml \
    python3-psutil \
    python3-bcrypt \
    python3-docker && break || sleep 5; done \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. Hardware Tools Validation
RUN which smartctl || (echo "CRITICAL: smartctl failed to install!" && exit 1)

# 3. Application Setup
WORKDIR /docker
# Copy monitoring agents and their specific requirements
COPY control-plane/agents/requirements.txt .
RUN python3 -m pip install --no-cache-dir --default-timeout=1000 --retries 10 -r requirements.txt || true

COPY control-plane/agents/ agents/

# 4. User Configuration
RUN groupadd -g 1000 appuser && \
    (getent group docker || groupadd -g 999 docker) && \
    useradd -m -u 1000 -g 1000 -G 0,docker appuser && \
    chown -R appuser:appuser /docker

# Standardize path for smartctl
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Runtime metrics usually need root for hardware access (smartctl, docker socket)
USER root

# Startup command
CMD ["python3", "-u", "agents/metrics.py"]
